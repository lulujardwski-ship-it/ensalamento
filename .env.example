# Examples only. Set real values in the Render environment, never in Git.
APP_ENV=development
DEV_LOGIN_ENABLED=false
TRUST_PROXY=false
DATABASE_URL=sqlite:///local.db
SECRET_KEY=replace-with-a-random-local-value-at-least-32-characters
# Public URL of the frontend. Empty in local development uses the backend origin.
FRONTEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
ALLOWED_DOMAINS=
ADMIN_EMAILS=
# Optional override; otherwise core/ensalamento-core[.exe]
CORE_BINARY=
